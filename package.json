{
  "name": "story-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint --quiet --cache --report-unused-disable-directives \"src/**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint --quiet --cache --report-unused-disable-directives --fix \"src/**/*.{ts,tsx,js,jsx}\"",
    "format": "prettier --write --ignore-unknown .",
    "prepare": "husky"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@tanstack/react-query": "^5.51.23",
    "axios": "^1.7.4",
    "framer-motion": "^11.3.28",
    "install": "^0.13.0",
    "loaders.css": "^0.1.2",
    "lodash": "^4.17.21",
    "luxon": "^3.5.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.3.1",
    "react-loaders": "^3.0.1",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.26.0",
    "sass": "^1.77.8",
    "suneditor": "^2.47.0",
    "suneditor-react": "^3.6.1",
    "swiper": "^11.1.9",
    "yup": "^1.4.0",
    "zustand": "^5.0.0-rc.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.10",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint",
      "prettier --check"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --check"
    ]
  }
}
